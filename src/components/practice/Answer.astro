---
// The answer and worked solution, closed until the student asks for it. A
// native <details>, so it opens without JavaScript. Kept out of the search
// index: an excerpt could otherwise show the answer to a student who has not
// asked for it.
---

<details class="answer" data-part="answer" data-pagefind-ignore>
  <summary>Show answer</summary>
  <div class="answer-body"><slot /></div>
</details>
