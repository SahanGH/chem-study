<button class="icon-btn" type="button" data-search-open aria-label="Search">
  <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
    <circle cx="7.5" cy="7.5" r="5.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
    <path d="M11.6 11.6 16 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
</button>

<dialog class="search-dialog" data-search-dialog aria-label="Search ChemStudy">
  <form class="search-close-form" method="dialog">
    <button class="search-close" type="submit">Close</button>
  </form>
  <div id="search-ui"></div>
  <p class="search-note" data-search-note hidden>
    Search could not load. Check your connection and try again.
</p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  const note = document.querySelector<HTMLElement>('[data-search-note]');
  const searchUi = document.querySelector<HTMLElement>('#search-ui');
  let started = false;
  // Everything start() adds to the page, so a failed attempt can be undone.
  let injected: HTMLElement[] = [];

  function loadScript(src: string): Promise<void> {
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = src;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error(`Could not load ${src}`));
      injected.push(script);
      document.head.append(script);
    });
  }

  // The search index and its UI are fetched the first time search is opened,
  // so pages that never search never pay for them.
  async function start(): Promise<void> {
    if (started) return;
    started = true;
    if (note) note.hidden = true;
    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = '/pagefind/pagefind-ui.css';
    injected.push(css);
    document.head.append(css);
    try {
      await loadScript('/pagefind/pagefind-ui.js');
      const PagefindUI = (window as unknown as { PagefindUI?: new (options: object) => unknown })
        .PagefindUI;
      if (!PagefindUI) throw new Error('pagefind-ui.js loaded but did not define PagefindUI');
      new PagefindUI({ element: '#search-ui', showImages: false, showSubResults: true });
      dialog?.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.focus();
    } catch (error) {
      console.error(error);
      // A dropped connection is usually temporary, so leave nothing behind that
      // would make the next open skip the request.
      for (const element of injected) element.remove();
      injected = [];
      searchUi?.replaceChildren();
      started = false;
      if (note) note.hidden = false;
    }
  }

  function open(): void {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    void start().then(() => dialog.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.focus());
  }

  for (const button of document.querySelectorAll('[data-search-open]')) {
    button.addEventListener('click', open);
  }

  // A result on the page you are already on only changes the fragment, so the
  // page never reloads and a modal left open would cover what was just chosen.
  // The click is not prevented, so the browser still follows the link. Enter on
  // a focused link fires this same click event.
  dialog?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('#search-ui a')) dialog.close();
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target;
    const typing =
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement ||
      (target instanceof HTMLElement && target.isContentEditable);
    // Ctrl, Cmd and Alt with a slash belong to the browser or the system.
    const modified = event.ctrlKey || event.metaKey || event.altKey;
    if (event.key === '/' && !typing && !modified && !event.defaultPrevented) {
      event.preventDefault();
      open();
    }
  });
</script>
