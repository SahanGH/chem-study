---
// Two or more <Lewis> structures side by side, with a resonance arrow between
// neighbors. Each structure draws its own arrow; the stylesheet shows it only
// on a structure that follows another one inside this group.
const structures = await Astro.slots.render('default');
const count = structures.match(/<div\b[^>]*\bdata-lewis\b/g)?.length ?? 0;
if (count < 2) {
  throw new Error(`<Resonance> needs two or more <Lewis> structures inside it, but it holds ${count}.`);
}
---

<div class="resonance" role="group" aria-label="Resonance structures"><Fragment set:html={structures} /></div>
