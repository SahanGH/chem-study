---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/inter';
import 'katex/dist/katex.min.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/prose.css';
import '../styles/print.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Unit number: sets the page's accent color. */
  unit?: number;
  /** Topic code, on lesson pages only. */
  topic?: string;
}
const { title, description, unit, topic } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Pages may load only this site's own files. Inline scripts and styles stay
// allowed: Astro inlines its small scripts, and KaTeX sizes math with style
// attributes. 'wasm-unsafe-eval' lets the search index (WebAssembly) run.
// "data:" is for the small fonts the build inlines into the stylesheet and
// the icons in the search box. Because inline scripts are allowed, this
// limits where files load from; it would not stop a script injected into a
// page. A <meta> tag rather than a response header, because SiteGround can
// serve files without consulting public/.htaccess.
const contentSecurityPolicy = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'",
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self' data:",
  "img-src 'self' data:",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      (function () {
        var theme = null;
        try {
          theme = localStorage.getItem('chemstudy:theme');
        } catch (e) {
          // Storage blocked: fall through to the device setting.
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body data-unit={unit}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-topic={topic}>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/progress-ui';
      import '../scripts/scrolling-equations';
    </script>
  </body>
</html>
