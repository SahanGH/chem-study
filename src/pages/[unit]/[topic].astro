---
import { getCollection, render } from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';
import AbsorbanceExplorer from '../../components/lesson/AbsorbanceExplorer.astro';
import BondEnergyCurve from '../../components/lesson/BondEnergyCurve.astro';
import Calorimetry from '../../components/lesson/Calorimetry.astro';
import CatalystProfile from '../../components/lesson/CatalystProfile.astro';
import Check from '../../components/lesson/Check.astro';
import ConcentrationPlots from '../../components/lesson/ConcentrationPlots.astro';
import EquilibriumApproach from '../../components/lesson/EquilibriumApproach.astro';
import EquilibriumShift from '../../components/lesson/EquilibriumShift.astro';
import Figure from '../../components/lesson/Figure.astro';
import HeatingCurve from '../../components/lesson/HeatingCurve.astro';
import KeyIdea from '../../components/lesson/KeyIdea.astro';
import KeyPoints from '../../components/lesson/KeyPoints.astro';
import Lewis from '../../components/lesson/Lewis.astro';
import LimitingReactant from '../../components/lesson/LimitingReactant.astro';
import MaxwellBoltzmann from '../../components/lesson/MaxwellBoltzmann.astro';
import PeriodicTrends from '../../components/lesson/PeriodicTrends.astro';
import PhotoelectronSpectrum from '../../components/lesson/PhotoelectronSpectrum.astro';
import PracticeNext from '../../components/lesson/PracticeNext.astro';
import RateLawExplorer from '../../components/lesson/RateLawExplorer.astro';
import Resonance from '../../components/lesson/Resonance.astro';
import ShapeViewer from '../../components/lesson/ShapeViewer.astro';
import Titration from '../../components/lesson/Titration.astro';
import Trap from '../../components/lesson/Trap.astro';
import Worked from '../../components/lesson/Worked.astro';
import WeakAcid from '../../components/lesson/WeakAcid.astro';
import { topicByCode } from '../../data/units';
import { lessonSlug, type Lesson } from '../../lib/lessons';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => {
    const found = topicByCode(lesson.data.topic);
    if (!found) throw new Error(`Lesson ${lesson.id} has an unknown topic ${lesson.data.topic}.`);
    return { params: { unit: found.unit.slug, topic: lessonSlug(lesson) }, props: { lesson } };
  });
}

interface Props {
  lesson: Lesson;
}
const { lesson } = Astro.props;
const { Content, headings } = await render(lesson);
// Supplied to every lesson, so lesson files need no imports.
const blocks = {
  AbsorbanceExplorer,
  BondEnergyCurve,
  Calorimetry,
  CatalystProfile,
  Check,
  ConcentrationPlots,
  EquilibriumApproach,
  EquilibriumShift,
  Figure,
  HeatingCurve,
  KeyIdea,
  KeyPoints,
  Lewis,
  LimitingReactant,
  MaxwellBoltzmann,
  PeriodicTrends,
  PhotoelectronSpectrum,
  PracticeNext,
  RateLawExplorer,
  Resonance,
  ShapeViewer,
  Titration,
  Trap,
  WeakAcid,
  Worked,
};
---

<LessonLayout lesson={lesson} headings={headings}>
  <Content components={blocks} />
</LessonLayout>
