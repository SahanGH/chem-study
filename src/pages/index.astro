---
import Base from '../layouts/Base.astro';
import { units } from '../data/units';
import type { LessonLink } from '../lib/continue';
import { lessonPath, lessonsByTopic } from '../lib/lessons';

const lessons = await lessonsByTopic();
// Every published lesson in course order, for the "continue" offer: the
// script needs to know which lesson comes after the one a student finished.
const lessonLinks: LessonLink[] = units.flatMap((unit) =>
  unit.topics.flatMap((topic) => {
    const lesson = lessons.get(topic.code);
    return lesson ? [{ topic: topic.code, path: lessonPath(unit.slug, lesson), title: topic.title }] : [];
  }),
);
const rows = units.map((unit) => ({
  unit,
  ready: unit.topics.filter((t) => lessons.has(t.code)).map((t) => t.code),
}));
const first = rows.find((row) => row.ready.length > 0);
const readyCount = lessons.size;
const topicCount = units.reduce((sum, unit) => sum + unit.topics.length, 0);

function status(ready: number, total: number): string {
  if (ready === 0) return 'Coming soon';
  return ready === total ? `${total} lessons` : `${ready} of ${total} lessons ready`;
}
---

<Base
  title="ChemStudy: AP® Chemistry, explained"
  description="Clear lessons, worked examples and practice for AP Chemistry, one topic at a time. Free, and written by a chemistry teacher."
>
  <section class="hero">
    <h1>AP® Chemistry, explained so it <em>finally clicks</em>.</h1>
    <p class="lede">
      A clear, careful lesson for each topic, with worked examples and practice to make it stick.
      Free, and written by a chemistry teacher.
    </p>
    {
      readyCount < topicCount && (
        <p class="hero-note">
          {readyCount} of {topicCount} lessons {readyCount === 1 ? 'is' : 'are'} ready so far. New ones are added as
          each is written and checked.
        </p>
      )
    }
    <p class="hero-actions">
      {
        first && (
          <a class="button" href={`/${first.unit.slug}/`}>
            Start with Unit {first.unit.number}
          </a>
        )
      }
      <a href="#units">See all nine units</a>
    </p>
    {/* Keep the label, the space and the link on one line: Astro drops the space when an inline element starts a new line. */}
    <p class="continue" data-continue data-lessons={JSON.stringify(lessonLinks)} hidden><span data-continue-label>Continue where you left off:</span>{' '}<a href="/">your last lesson</a></p>
  </section>

  <section id="units" aria-labelledby="units-heading">
    <h2 id="units-heading" class="eyebrow">The nine units</h2>
    <ul class="unit-list">
      {
        rows.map(({ unit, ready }) => (
          <li class="unit-row" data-unit={unit.number} data-unit-topics={ready.join(',')}>
            <span class="dot" aria-hidden="true" />
            <span class="unit-num">Unit {unit.number}</span>
            {ready.length > 0 ? (
              <a class="unit-title" href={`/${unit.slug}/`}>
                {unit.title}
              </a>
            ) : (
              <span class="unit-title">{unit.title}</span>
            )}
            <span class="unit-meta">
              {status(ready.length, unit.topics.length)}<span data-unit-progress />
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
